<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kh.rechargetech.mmm.member.mapper.MemberMapper">

    <select id="loginMember" parameterType="kh.rechargetech.mmm.member.model.vo.Member" 
            resultType="kh.rechargetech.mmm.member.model.vo.Member">
        SELECT *
        FROM MEMBER
        WHERE MEMBER_ID = #{memberId}
          AND MEMBER_PW = #{memberPw}
          AND STATUS = 'Y'
    </select>

</mapper>