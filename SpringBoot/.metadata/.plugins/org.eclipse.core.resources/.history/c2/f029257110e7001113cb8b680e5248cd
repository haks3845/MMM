package kh.rechargetech.mmm.map.service;

import kh.rechargetech.mmm.map.mapper.StationMapper;
import kh.rechargetech.mmm.map.model.vo.ChargeStation;
import kh.rechargetech.mmm.map.model.vo.ChargerDetail;
import kh.rechargetech.mmm.map.model.vo.StationMapPin;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.client.RestClient;
import org.springframework.web.util.UriComponentsBuilder;
import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.JsonNode;
import tools.jackson.databind.ObjectMapper;

import java.net.URI;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Slf4j
@Service
@RequiredArgsConstructor
public class StationService {

    private final StationMapper stationMapper;
    private final ObjectMapper objectMapper;
    private final RestClient restClient = RestClient.create();

    @Value("${ev.api.base-url}")
    private String baseUrl;

    @Value("${ev.api.service-key}")
    private String serviceKey;

    @Transactional
    public int insertStationList(String jsonString) {
        int result = 0;

        try {
            JsonNode rootNode = objectMapper.readTree(jsonString);
            JsonNode itemArrayNode = rootNode.path("items").path("item");

            if (itemArrayNode.isArray() && !itemArrayNode.isEmpty()) {
                List<ChargeStation> stationList = objectMapper.readValue(
                        itemArrayNode.toString(),
                        new TypeReference<ArrayList<ChargeStation>>() {}
                );

                result = stationMapper.insertStationList(stationList);

                if (result >= 0) {
                    log.info("🚀 [DB 성공] 전기차 충전소 데이터 {}건 저장/업데이트 완료.", stationList.size());
                }
            } else {
                log.warn("⚠️ 파싱할 충전기 데이터(item)가 존재하지 않습니다.");
            }

        } catch (Exception e) {
            log.error("❌ [에러] 서비스 내 JSON 파싱 및 DB 저장 중 예외 발생", e);
            throw new RuntimeException("충전소 데이터 저장 중 오류 발생", e);
        }

        return result;
    }

    public List<StationMapPin> getPins(double minLat, double minLng, double maxLat, double maxLng, int zoom) {
        if (zoom >= 15) return stationMapper.selectStations(minLat, minLng, maxLat, maxLng);
        if (zoom >= 13) return stationMapper.selectGridClusters(minLat, minLng, maxLat, maxLng);
        if (zoom >= 11) return stationMapper.selectSigunguClusters(minLat, minLng, maxLat, maxLng);
        return stationMapper.selectSidoClusters(minLat, minLng, maxLat, maxLng);
    }

    /**
     * 충전소 클릭 시 DB의 충전기 기본 정보 + 공공데이터 실시간 상태(stat) 병합 반환
     */
    public List<ChargerDetail> getChargers(String statId) {
        // 1. DB에서 충전기 기본 목록 조회
        List<ChargerDetail> chargers = stationMapper.selectChargersByStation(statId);
        if (chargers == null || chargers.isEmpty()) {
            return chargers;
        }

        // 2. 공공데이터포털 getChargerStatus 호출해서 실시간 상태 조회
        Map<String, String> realtimeStatusMap = fetchRealtimeStatusMap(statId);

        // 3. 실시간 상태가 있으면 덮어쓰기 (API 실패 시 DB의 기존 상태값 유지)
        if (!realtimeStatusMap.isEmpty()) {
            for (ChargerDetail charger : chargers) {
                String latestStat = realtimeStatusMap.get(charger.getChgerId());
                if (latestStat != null && !latestStat.isBlank()) {
                    charger.setStat(latestStat);
                    charger.setStatNm(convertStatToName(latestStat));
                }
            }
        }

        return chargers;
    }

    /**
     * 특정 충전소(statId)의 실시간 충전기 상태만 공공데이터 API에서 조회
     */
    private Map<String, String> fetchRealtimeStatusMap(String statId) {
        Map<String, String> statMap = new HashMap<>();
        try {
            // 기존 getChargerInfo URL을 getChargerStatus로 치환하여 사용
            String statusUrl = baseUrl.replace("getChargerInfo", "getChargerStatus");

            URI uri = UriComponentsBuilder.fromUriString(statusUrl)
                    .queryParam("serviceKey", serviceKey)
                    .queryParam("pageNo", 1)
                    .queryParam("numOfRows", 100)
                    .queryParam("statId", statId)
                    .queryParam("dataType", "JSON")
                    .build(true)
                    .toUri();

            String jsonResult = restClient.get()
                    .uri(uri)
                    .header("Accept", "application/json")
                    .retrieve()
                    .body(String.class);

            JsonNode rootNode = objectMapper.readTree(jsonResult);
            JsonNode itemArrayNode = rootNode.path("items").path("item");

            if (itemArrayNode.isArray()) {
                for (JsonNode item : itemArrayNode) {
                    String chgerId = item.path("chgerId").asText();
                    String stat = item.path("stat").asText();
                    statMap.put(chgerId, stat);
                }
            }
        } catch (Exception e) {
            log.warn("⚠️ 실시간 충전기 상태 조회 실패 (statId: {}) - DB 기존 값으로 대체합니다. 사유: {}", statId, e.getMessage());
        }
        return statMap;
    }

    /**
     * 상태 코드 -> 한글 명칭 변환 (리액트 c.statNm 표시용)
     */
    private String convertStatToName(String stat) {
        return switch (stat) {
            case "1" -> "통신이상";
            case "2" -> "충전대기";
            case "3" -> "충전중";
            case "4" -> "운영중지";
            case "5" -> "점검중";
            default -> "상태미확인";
        };
    }
}