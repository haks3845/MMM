<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kh.rechargetech.mmm.map.mapper.StationMapper">

	<insert id="insertStationList" parameterType="java.util.List">
		MERGE INTO CHARGING_STATION T
		USING (
		<foreach collection="list" item="item" index="index"
			separator="UNION ALL">
			SELECT
			#{item.statId, jdbcType=VARCHAR} AS STATID,
			#{item.chgerId, jdbcType=VARCHAR} AS CHGERID,
			#{item.statNm,
			jdbcType=VARCHAR} AS STATNM,
			#{item.chgerType, jdbcType=VARCHAR} AS
			CHGERTYPE,
			#{item.addr, jdbcType=VARCHAR} AS ADDR,
			#{item.addrDetail,
			jdbcType=VARCHAR} AS ADDRDETAIL,
			#{item.location, jdbcType=VARCHAR} AS
			LOCATION,
			#{item.lat, jdbcType=NUMERIC} AS LAT,
			#{item.lng,
			jdbcType=NUMERIC} AS LNG,
			#{item.useTime, jdbcType=VARCHAR} AS
			USETIME,
			#{item.busiId, jdbcType=VARCHAR} AS BUSIID,
			#{item.bnm,
			jdbcType=VARCHAR} AS BNM,
			#{item.busiNm, jdbcType=VARCHAR} AS BUSINM,
			#{item.busiCall, jdbcType=VARCHAR} AS BUSICALL,
			#{item.stat,
			jdbcType=VARCHAR} AS STAT,
			#{item.statUpdDt, jdbcType=VARCHAR} AS
			STATUPDDT,
			#{item.lastTsdt, jdbcType=VARCHAR} AS LASTTSDT,
			#{item.lastTedt, jdbcType=VARCHAR} AS LASTTEDT,
			#{item.nowTsdt,
			jdbcType=VARCHAR} AS NOWTSDT,
			#{item.output, jdbcType=NUMERIC} AS
			OUTPUT,
			#{item.method, jdbcType=VARCHAR} AS METHOD,
			#{item.zcode,
			jdbcType=VARCHAR} AS ZCODE,
			#{item.zscode, jdbcType=VARCHAR} AS
			ZSCODE,
			#{item.kind, jdbcType=VARCHAR} AS KIND,
			#{item.kindDetail,
			jdbcType=VARCHAR} AS KINDDETAIL,
			#{item.parkingFree, jdbcType=VARCHAR}
			AS PARKINGFREE,
			#{item.note, jdbcType=VARCHAR} AS NOTE,
			#{item.limitYn, jdbcType=VARCHAR} AS LIMITYN,
			#{item.limitDetail,
			jdbcType=VARCHAR} AS LIMITDETAIL,
			#{item.delYn, jdbcType=VARCHAR} AS
			DELYN,
			#{item.delDetail, jdbcType=VARCHAR} AS DELDETAIL,
			#{item.trafficYn, jdbcType=VARCHAR} AS TRAFFICYN,
			#{item.year,
			jdbcType=VARCHAR} AS YEAR,
			#{item.floorNum, jdbcType=VARCHAR} AS
			FLOORNUM,
			#{item.floorType, jdbcType=VARCHAR} AS FLOORTYPE
			FROM DUAL
		</foreach>
		) S
		ON (T.STATID = S.STATID AND T.CHGERID = S.CHGERID)
		WHEN MATCHED THEN
		UPDATE SET
		T.STATNM = S.STATNM,
		T.CHGERTYPE = S.CHGERTYPE,
		T.ADDR =
		S.ADDR,
		T.ADDRDETAIL = S.ADDRDETAIL,
		T.LOCATION = S.LOCATION,
		T.LAT =
		S.LAT,
		T.LNG = S.LNG,
		T.USETIME = S.USETIME,
		T.BUSIID = S.BUSIID,
		T.BNM =
		S.BNM,
		T.BUSINM = S.BUSINM,
		T.BUSICALL = S.BUSICALL,
		T.STAT = S.STAT,
		T.STATUPDDT = S.STATUPDDT,
		T.LASTTSDT = S.LASTTSDT,
		T.LASTTEDT =
		S.LASTTEDT,
		T.NOWTSDT = S.NOWTSDT,
		T.OUTPUT = S.OUTPUT,
		T.METHOD =
		S.METHOD,
		T.ZCODE = S.ZCODE,
		T.ZSCODE = S.ZSCODE,
		T.KIND = S.KIND,
		T.KINDDETAIL = S.KINDDETAIL,
		T.PARKINGFREE = S.PARKINGFREE,
		T.NOTE =
		S.NOTE,
		T.LIMITYN = S.LIMITYN,
		T.LIMITDETAIL = S.LIMITDETAIL,
		T.DELYN =
		S.DELYN,
		T.DELDETAIL = S.DELDETAIL,
		T.TRAFFICYN = S.TRAFFICYN,
		T.YEAR =
		S.YEAR,
		T.FLOORNUM = S.FLOORNUM,
		T.FLOORTYPE = S.FLOORTYPE
		WHEN NOT
		MATCHED THEN
		INSERT (
		STATID, CHGERID, STATNM, CHGERTYPE, ADDR,
		ADDRDETAIL, LOCATION,
		LAT, LNG, USETIME, BUSIID, BNM, BUSINM, BUSICALL,
		STAT,
		STATUPDDT, LASTTSDT, LASTTEDT, NOWTSDT, OUTPUT, METHOD,
		ZCODE,
		ZSCODE, KIND, KINDDETAIL, PARKINGFREE, NOTE, LIMITYN,
		LIMITDETAIL,
		DELYN, DELDETAIL, TRAFFICYN, YEAR, FLOORNUM, FLOORTYPE
		) VALUES (
		S.STATID, S.CHGERID, S.STATNM, S.CHGERTYPE, S.ADDR, S.ADDRDETAIL,
		S.LOCATION,
		S.LAT, S.LNG, S.USETIME, S.BUSIID, S.BNM, S.BUSINM,
		S.BUSICALL,
		S.STAT,
		S.STATUPDDT, S.LASTTSDT, S.LASTTEDT, S.NOWTSDT,
		S.OUTPUT, S.METHOD,
		S.ZCODE, S.ZSCODE, S.KIND, S.KINDDETAIL,
		S.PARKINGFREE, S.NOTE, S.LIMITYN,
		S.LIMITDETAIL, S.DELYN, S.DELDETAIL,
		S.TRAFFICYN, S.YEAR, S.FLOORNUM,
		S.FLOORTYPE
		)
	</insert>

	<select id="selectStationsWithinBounds" parameterType="map"
		resultType="kh.rechargetech.mmm.map.model.vo.StationMapPin">
		SELECT
		STATID,
		MAX(STATNM) AS statNm,
		MAX(LAT) AS lat,
		MAX(LNG) AS lng,
		MAX(ADDR) AS addr,
		COUNT(CHGERID) AS chgerCount
		FROM
		CHARGING_STATION
		WHERE LAT BETWEEN #{swLat} AND #{neLat}
		AND LNG BETWEEN
		#{swLng} AND #{neLng}
		AND REGEXP_LIKE(LAT, '^[0-9]+(\.[0-9]+)?$')
		AND
		REGEXP_LIKE(LNG, '^[0-9]+(\.[0-9]+)?$')
		GROUP BY STATID
		FETCH FIRST 200
		ROWS ONLY
	</select>

	<sql id="boundsWhere">
		WHERE LAT BETWEEN #{minLat} AND #{maxLat}
		AND LNG BETWEEN #{minLng} AND #{maxLng}
	</sql>

</mapper>